# Sedna Warden fleet defaults (vectored-thrust boat, forward-only outboard)
# Source: fleet param files (Warden-1 2026-11-15, Warden-7 2026-11-09).
# Only fleet-wide values that differ from the firmware/board defaults are
# listed here. Per-unit calibration (IMU, compass, level trim, radio) and
# per-boat settings (MAV_SYSID, servo trims) must still be set per vehicle.

# --- frame and board mounting ---
FRAME_CLASS 2
AHRS_ORIENTATION 6
AHRS_OPTIONS 0
INS_POS1_X 0.35
INS_POS2_X 0.35
INS_POS3_X 0.35
BRD_SAFETY_DEFLT 0
BRD_SAFETYOPTION 0

# --- outputs: SERVO1 thrust, SERVO2 steering, AUX1-4 (SERVO9-12) GPIO relays ---
SERVO1_FUNCTION 70
SERVO2_FUNCTION 26
SERVO3_FUNCTION 0
SERVO4_FUNCTION -1
SERVO5_FUNCTION -1
SERVO9_FUNCTION -1
SERVO10_FUNCTION -1
SERVO10_MIN 1000
SERVO10_MAX 2000
SERVO11_FUNCTION -1
SERVO12_FUNCTION -1
SERVO16_FUNCTION 28

# --- motors / vectored thrust ---
MOT_THR_MAX 45
MOT_SLEWRATE 10
MOT_VEC_ANGLEMAX 40
MOT_VEC_STR_SLEW 120
MOT_REV_DELAY 0.5
MOT_FSTART_ENBL 2
MOT_FSTART_RPM 2000

# --- relays: 1-2 on DroneCAN hardpoints 0-1 (Matek node), 3-6 on AUX1-4 ---
RELAY1_FUNCTION 1
RELAY1_PIN 1000
RELAY1_DEFAULT 1
RELAY2_FUNCTION 1
RELAY2_PIN 1001
RELAY3_FUNCTION 1
RELAY3_PIN 50
RELAY4_FUNCTION 1
RELAY4_PIN 51
RELAY5_FUNCTION 1
RELAY5_PIN 52
RELAY5_DEFAULT 1
RELAY6_FUNCTION 1
RELAY6_PIN 53
BCNL_ENABLE 1

# --- payload: gripper on SERVO16, button, tether drop ---
GRIP_ENABLE 1
GRIP_TYPE 1
BTN_ENABLE 1
BTN_PIN1 2
BTN_FUNC1 34
BTN_OPTIONS1 4
TTDR_TYPE 1
TTDR_MAX_DEPTH 14
TTDR_OPTIONS 0

# --- CAN (DroneCAN on both ports, SLCAN on CAN2) ---
CAN_P1_DRIVER 1
CAN_P2_DRIVER 1
CAN_P2_OPTIONS 2
CAN_D2_PROTOCOL 0
CAN_D1_UC_ESC_BM 1
CAN_D1_UC_ESC_RV 1
CAN_D1_UC_SRV_BM 30
CAN_SLCAN_CPORT 1

# --- serial ports and MAVLink streams ---
SERIAL1_PROTOCOL -1
SERIAL2_PROTOCOL 51
SERIAL2_BAUD 19
SERIAL4_PROTOCOL 31
SERIAL4_BAUD 115
SERIAL5_PROTOCOL 1
MAV1_EXT_STAT 2
MAV1_EXTRA1 10
MAV1_EXTRA2 4
MAV1_EXTRA3 2
MAV1_OPTIONS 4
MAV1_POSITION 8
MAV1_RAW_CTRL 0
MAV1_RAW_SENS 2
MAV1_RC_CHAN 2

# --- GPS (DroneCAN) ---
GPS1_TYPE 9
GPS1_POS_X 1.05
GPS1_POS_Z 0.2
GPS_AUTO_CONFIG 2
GPS_NAVFILTER 5

# --- compass ---
COMPASS_DISBLMSK 32

# --- battery: analog power brick + DroneCAN monitors (Matek nodes) ---
BATT_MONITOR 4
BATT_CAPACITY 50000
BATT_VOLT_MULT 12.02
BATT_AMP_PERVLT 39.877
BATT2_MONITOR 8
BATT2_CAPACITY 50000
BATT2_SERIAL_NUM 1
BATT3_MONITOR 8
BATT3_SERIAL_NUM 2

# --- RC input ---
RC_PROTOCOLS 8
RC1_DZ 30
RC3_DZ 30
RC4_DZ 30
RC5_OPTION 153

# --- navigation and speed ---
INITIAL_MODE 4
CRUISE_SPEED 1.05
CRUISE_THROTTLE 40
WP_SPEED 1.05
WP_RADIUS 5
TURN_RADIUS 2.5
LOIT_TYPE 3
LOIT_RADIUS 15
MIS_DONE_BEHAVE 1
GUID_OPTIONS 64
AVOID_ENABLE 0

# --- steering and speed control tuning ---
ACRO_TURN_RATE 12
ATC_ACCEL_MAX 0.3
ATC_BRAKE 0
ATC_SPEED_P 0.1
ATC_SPEED_I 0.05
ATC_SPEED_IMAX 0.5
ATC_STR_ACC_MAX 0
ATC_STR_ANG_P 1
ATC_STR_RAT_FF 0.6
ATC_STR_RAT_P 0.07
ATC_STR_RAT_I 0
ATC_STR_RAT_D 0.01
ATC_STR_RAT_IMAX 0.1
ATC_STR_RAT_PDMX 0.4
ATC_STR_RAT_MAX 15
ATC_TURN_MAX_G 1
# drift compensation (current and wind), ignored by firmware without it
PSC_DRIFT_EN 1

# --- failsafes and arming ---
# FS_THR_ENABLE kept from the previous board defaults; Warden-7 uses 2
FS_THR_ENABLE 0
FS_EKF_ACTION 2
ARMING_RUDDER 0
# fleet setting: skip most pre-arm checks, including IMU/compass calibration,
# so check calibration before first use of a new unit
ARMING_SKIPCHK 1048062

# --- notify and logging ---
NTF_BUZZ_TYPES 4
NTF_BUZZ_VOLUME 10
NTF_LED_TYPES 123079
LOG_FILE_BUFSIZE 200
