include ../CubeOrangePlus/hwdef.dat
define AP_CUSTOM_FIRMWARE_STRING "SednaWarden"

# pull AUX pins low so they can't float high between AF pin setup and RCOutput claiming them
undef PE14 PE13 PE11 PE9 PD13 PD14
PE14 TIM1_CH4 TIM1 PWM(1) GPIO(50) PULLDOWN
PE13 TIM1_CH3 TIM1 PWM(2) GPIO(51) PULLDOWN
PE11 TIM1_CH2 TIM1 PWM(3) GPIO(52) PULLDOWN
PE9  TIM1_CH1 TIM1 PWM(4) GPIO(53) PULLDOWN
PD13 TIM4_CH2 TIM4 PWM(5) GPIO(54) PULLDOWN
PD14 TIM4_CH3 TIM4 PWM(6) GPIO(55) PULLDOWN