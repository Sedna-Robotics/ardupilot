###########################################################################################################################################################
# mRo CAN PWM breakout - Sedna Warden variant with VE.Direct battery monitoring
# 12x PWM / IO 3V3 logic level
# Connector options: 90deg 0.1", straight or no headers.
# External power supply for servos in solder pads.
# 1x UART port exposed in solder pads configured for VE.Direct protocol.
# Blue LED status indicator.
# Uncased Weight and Dimensions:
# Weight: g ()
# Width:  33mm (in)
# Length: 31.3mm (in)
# Screw hole pattern: 19x25mm
# M10126A - Initial release March 2023
# SWarden variant - VE.Direct battery monitor configuration
###########################################################################################################################################################

MCU STM32G4xx STM32G474xx

FLASH_RESERVE_START_KB 40
FLASH_SIZE_KB 512

STORAGE_FLASH_PAGE 16
define HAL_STORAGE_SIZE 2000

# board ID. See Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID AP_HW_mRoCANPWM

OSCILLATOR_HZ 8000000

# setup build for a peripheral firmware
env AP_PERIPH 1

# Use bootloader from base board
USE_BOOTLOADER_FROM_BOARD mRoCANPWM-M10126

# Short board name (max 23 chars for system ID)
define CHIBIOS_SHORT_BOARD_NAME "mRoM10126_SW"

# Expose serial manager parameters
define HAL_PERIPH_SHOW_SERIAL_MANAGER_PARAMS

# debug on USART1 - DISABLED to allow USART1 for VE.Direct
# STDOUT_SERIAL SD1
# STDOUT_BAUDRATE 57600

# order of UARTs (USART1 available as SERIAL0 for VE.Direct)
SERIAL_ORDER USART1

# Note: SERIAL0_PROTOCOL and SERIAL0_BAUD are set via defaults.parm
# (defines don't work due to hardcoded defaults in AP_SerialManager.cpp)

# LEDs
PB10 LED OUTPUT HIGH  # blue

# USART1
PB6 USART1_TX USART1 NODMA
PB7 USART1_RX USART1 NODMA

# SWD debugging
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

define HAL_USE_ADC FALSE
define STM32_ADC_USE_ADC1 FALSE
define HAL_DISABLE_ADC_DRIVER TRUE

#define DMA_RESERVE_SIZE 2048

# enable CAN support
PA11 CAN1_RX CAN1
PA12 CAN1_TX CAN1

# keep ROMFS uncompressed as we don't have enough RAM
# to uncompress the bootloader at runtime
env ROMFS_UNCOMPRESSED True

define CAN_APP_NODE_NAME "io.mrobotics.mRoCANPWM-M10126-SWarden"

# PWM with bidirectional DShot support (TIM15_CH2 does not support BIDIR on STM32G4)
PA0     TIM5_CH1    TIM5    PWM(1)  GPIO(50) BIDIR
PA1     TIM5_CH2    TIM5    PWM(2)  GPIO(51) BIDIR
PA2     TIM5_CH3    TIM5    PWM(3)  GPIO(52) BIDIR
PA3     TIM5_CH4    TIM5    PWM(4)  GPIO(53) BIDIR
PB15    TIM15_CH2   TIM15   PWM(5)  GPIO(54)
PA8     TIM1_CH1    TIM1    PWM(6)  GPIO(55) BIDIR
PA9     TIM1_CH2    TIM1    PWM(7)  GPIO(56) BIDIR
PA10    TIM1_CH3    TIM1    PWM(8)  GPIO(57) BIDIR
PA6     TIM3_CH1    TIM3    PWM(9)  GPIO(58) BIDIR
PA7     TIM3_CH2    TIM3    PWM(10) GPIO(59) BIDIR
PB0     TIM3_CH3    TIM3    PWM(11) GPIO(60) BIDIR
PB1     TIM3_CH4    TIM3    PWM(12) GPIO(61) BIDIR

define AP_PERIPH_RC_OUT_ENABLED 1
#define AP_PERIPH_NOTIFY_ENABLED 1

# enable battery monitoring (for VE.Direct or other battery monitors)
define AP_PERIPH_BATTERY_ENABLED 1

# enable ESC control
define HAL_SERIAL_ESC_COMM_ENABLED 1
define HAL_SUPPORT_RCOUT_SERIAL 1
define HAL_WITH_ESC_TELEM 1

define HAL_MONITOR_THREAD_ENABLED 1
